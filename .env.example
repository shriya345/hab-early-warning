# Authenticated CDSE requests use CDSE_ACCESS_TOKEN when set; otherwise an OAuth client.
# Public STAC scene search needs no credentials. Set real values only in the
# backend process environment; never commit a populated .env file.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
CDSE_ACCESS_TOKEN=
# Keep the separate model-compatibility gate off until the archived scene
# selection/export contract has been verified for the intended lake.
HAB_SATELLITE_INPUT_CONTRACT_VERIFIED=
# Frontend build variable: public HTTPS backend origin (no credentials).
VITE_API_BASE_URL=
